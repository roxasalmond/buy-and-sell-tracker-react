# Firebase web config (Project settings > Your apps). These identify the project
# and are not secret; the database rules are what protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Phase 4 (writes). Both off by default.
# VITE_ENABLE_WRITES=true   turns the save buttons on (only against the emulator or a test project)
# VITE_USE_EMULATOR=true    use the local Firebase emulators (auth 9099, database 9000)
